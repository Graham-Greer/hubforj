rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return isSignedIn() ? userDoc().role : null;
    }

    function userHubId() {
      return isSignedIn() ? userDoc().hubId : null;
    }

    function isSuperadmin() {
      return isSignedIn() && userRole() == 'superadmin';
    }

    function isHubAdmin(hubId) {
      return isSignedIn() && userRole() == 'admin' && userHubId() == hubId;
    }

    function isHubMember(hubId) {
      return isSignedIn() && userHubId() == hubId && (userRole() == 'member' || userRole() == 'admin');
    }

    function registrationStatusValid(status) {
      return status in ['registered', 'waitlisted', 'cancelled'];
    }

    function paymentStatusValid(status) {
      return status in ['not-required', 'unpaid', 'paid', 'refunded'];
    }

    function attendanceStatusValid(status) {
      return status in ['unknown', 'attended', 'no-show'];
    }

    function registrationShapeValid() {
      return registrationStatusValid(request.resource.data.status)
        && paymentStatusValid(request.resource.data.paymentStatus)
        && attendanceStatusValid(request.resource.data.attendanceStatus)
        && (
          request.resource.data.status == 'registered'
          || request.resource.data.attendanceStatus == 'unknown'
        );
    }

    function registrationIdentityUnchanged() {
      return request.resource.data.hubId == resource.data.hubId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.userId == resource.data.userId;
    }

    function hubDocWriteKeysValid() {
      return request.resource.data.keys().hasOnly([
        'name',
        'slug',
        'templateKey',
        'tokenOverrides',
        'globalHeaderId',
        'globalFooterId',
        'features',
        'customDomains',
        'themeRevision',
        'themeCssPath',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hubDocUpdateKeysValid() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'name',
        'slug',
        'templateKey',
        'tokenOverrides',
        'globalHeaderId',
        'globalFooterId',
        'features',
        'customDomains',
        'themeRevision',
        'themeCssPath',
        'updatedAt'
      ]);
    }

    function inviteCreateKeysValid() {
      return request.resource.data.keys().hasOnly([
        'hubId',
        'email',
        'role',
        'status',
        'createdAt',
        'createdBy',
        'acceptedAt',
        'revokedAt',
        'updatedAt'
      ]);
    }

    function inviteValuesValid(hubId) {
      return request.resource.data.hubId == hubId
        && request.resource.data.role == 'admin'
        && request.resource.data.status in ['pending', 'accepted', 'revoked'];
    }

    function inviteUpdateKeysValid() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'acceptedAt',
        'revokedAt',
        'updatedAt'
      ]);
    }

    function inviteIdentityUnchanged() {
      return request.resource.data.hubId == resource.data.hubId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function membershipPlanCreateKeysValid() {
      return request.resource.data.keys().hasOnly([
        'hubId',
        'title',
        'description',
        'durationUnit',
        'durationValue',
        'price',
        'active',
        'imageMediaId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function membershipPlanUpdateKeysValid() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'title',
        'description',
        'durationUnit',
        'durationValue',
        'price',
        'active',
        'imageMediaId',
        'updatedAt'
      ]);
    }

    function membershipPlanValuesValid() {
      return request.resource.data.durationUnit in ['days', 'months', 'years']
        && request.resource.data.durationValue > 0
        && request.resource.data.price >= 0;
    }

    function membershipIdentityUnchanged() {
      return request.resource.data.hubId == resource.data.hubId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.planId == resource.data.planId;
    }

    function membershipCreateKeysValid() {
      return request.resource.data.keys().hasOnly([
        'hubId',
        'userId',
        'planId',
        'status',
        'paymentStatus',
        'startDate',
        'renewalDate',
        'gracePeriodDaysOverride',
        'createdAt',
        'updatedAt',
        'cancelledAt'
      ]);
    }

    function membershipUpdateKeysValid() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'paymentStatus',
        'startDate',
        'renewalDate',
        'gracePeriodDaysOverride',
        'updatedAt',
        'cancelledAt'
      ]);
    }

    function membershipValuesValid() {
      return request.resource.data.status in ['pending', 'active', 'expired', 'inactive', 'cancelled']
        && paymentStatusValid(request.resource.data.paymentStatus);
    }

    function eventCreateKeysValid() {
      return request.resource.data.keys().hasOnly([
        'hubId',
        'slug',
        'status',
        'title',
        'description',
        'imageMediaIds',
        'startAt',
        'endAt',
        'location',
        'capacity',
        'category',
        'tags',
        'pricingMode',
        'price',
        'registrationEligibility',
        'visibility',
        'registeredCount',
        'waitlistedCount',
        'createdAt',
        'updatedAt',
        'cancelledAt'
      ]);
    }

    function eventUpdateKeysValid() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'slug',
        'status',
        'title',
        'description',
        'imageMediaIds',
        'startAt',
        'endAt',
        'location',
        'capacity',
        'category',
        'tags',
        'pricingMode',
        'price',
        'registrationEligibility',
        'visibility',
        'registeredCount',
        'waitlistedCount',
        'updatedAt',
        'cancelledAt'
      ]);
    }

    function eventValuesValid() {
      return request.resource.data.status in ['draft', 'published', 'cancelled']
        && request.resource.data.category in ['Workshop', 'Meetup', 'Course']
        && request.resource.data.pricingMode in ['free', 'paid']
        && request.resource.data.registrationEligibility in ['members-only', 'guests-allowed']
        && request.resource.data.visibility in ['public', 'members-only'];
    }

    function registrationMemberCreateKeysValid() {
      return request.resource.data.keys().hasOnly([
        'hubId',
        'eventId',
        'userId',
        'status',
        'paymentStatus',
        'attendanceStatus',
        'createdAt',
        'updatedAt',
        'notes'
      ]);
    }

    function registrationMemberCreateValuesValid(hubId, eventId) {
      return request.resource.data.hubId == hubId
        && request.resource.data.eventId == eventId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['registered', 'waitlisted']
        && request.resource.data.paymentStatus in ['not-required', 'unpaid']
        && request.resource.data.attendanceStatus == 'unknown';
    }

    function registrationMemberCancelAllowed() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'updatedAt',
          'attendanceStatus'
        ])
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['registered', 'waitlisted']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.attendanceStatus == 'unknown'
        && request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    function registrationAdminUpdateAllowed(hubId) {
      return (isHubAdmin(hubId) || isSuperadmin())
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'paymentStatus',
          'attendanceStatus',
          'notes',
          'updatedAt'
        ])
        && registrationIdentityUnchanged()
        && registrationShapeValid();
    }

    function membershipMemberCancelAllowed() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'cancelledAt',
          'updatedAt'
        ])
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && resource.data.paymentStatus == request.resource.data.paymentStatus
        && resource.data.planId == request.resource.data.planId
        && resource.data.userId == request.resource.data.userId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isSuperadmin());
      allow update: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'avatarMediaId', 'updatedAt']);
      allow create: if false;
      allow delete: if false;
    }

    match /hubs/{hubId} {
      allow read: if isSuperadmin() || isHubMember(hubId);
      allow create: if isSuperadmin() && hubDocWriteKeysValid();
      allow update: if isSuperadmin() && hubDocWriteKeysValid() && hubDocUpdateKeysValid();
      allow delete: if false;

      match /invites/{inviteId} {
        allow read: if isSuperadmin() || isHubAdmin(hubId);
        allow create: if isSuperadmin() && inviteCreateKeysValid() && inviteValuesValid(hubId);
        allow update: if isSuperadmin()
          && inviteCreateKeysValid()
          && inviteValuesValid(hubId)
          && inviteUpdateKeysValid()
          && inviteIdentityUnchanged();
        allow delete: if false;
      }

      match /membershipPlans/{planId} {
        allow read: if true;
        allow create: if (isHubAdmin(hubId) || isSuperadmin())
          && membershipPlanCreateKeysValid()
          && request.resource.data.hubId == hubId
          && membershipPlanValuesValid();
        allow update: if (isHubAdmin(hubId) || isSuperadmin())
          && membershipPlanCreateKeysValid()
          && request.resource.data.hubId == resource.data.hubId
          && membershipPlanUpdateKeysValid()
          && membershipPlanValuesValid();
        allow delete: if isHubAdmin(hubId) || isSuperadmin();
      }

      match /memberships/{membershipId} {
        allow read: if isHubAdmin(hubId) || isSuperadmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid && isHubMember(hubId));
        allow create: if (isHubAdmin(hubId) || isSuperadmin())
          && membershipCreateKeysValid()
          && request.resource.data.hubId == hubId
          && membershipValuesValid();
        allow update: if ((isHubAdmin(hubId) || isSuperadmin())
            && membershipCreateKeysValid()
            && membershipUpdateKeysValid()
            && membershipIdentityUnchanged()
            && membershipValuesValid())
          || (isSignedIn() && isHubMember(hubId) && membershipMemberCancelAllowed());
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if resource.data.status == 'published' || isHubMember(hubId) || isSuperadmin();
        allow create: if (isHubAdmin(hubId) || isSuperadmin())
          && eventCreateKeysValid()
          && request.resource.data.hubId == hubId
          && eventValuesValid();
        allow update: if (isHubAdmin(hubId) || isSuperadmin())
          && eventCreateKeysValid()
          && eventUpdateKeysValid()
          && request.resource.data.hubId == resource.data.hubId
          && eventValuesValid();
        allow delete: if isHubAdmin(hubId) || isSuperadmin();

        match /registrations/{registrationId} {
          allow read: if isHubAdmin(hubId) || isSuperadmin()
            || (isSignedIn() && resource.data.userId == request.auth.uid && isHubMember(hubId));
          allow create: if isSignedIn() && isHubMember(hubId)
            && registrationMemberCreateKeysValid()
            && registrationMemberCreateValuesValid(hubId, eventId)
            && registrationShapeValid();
          allow update: if (isSignedIn() && isHubMember(hubId)
              && registrationMemberCancelAllowed()
              && registrationIdentityUnchanged())
            || registrationAdminUpdateAllowed(hubId);
          allow delete: if false;
        }
      }

      match /pages/{pageId} {
        allow read: if resource.data.publishedComposition.size() > 0 || isHubAdmin(hubId) || isSuperadmin();
        allow create: if isSuperadmin()
          && request.resource.data.keys().hasOnly([
            'hubId',
            'slug',
            'title',
            'status',
            'draftComposition',
            'publishedComposition',
            'headerIdOverride',
            'footerIdOverride',
            'seo',
            'createdAt',
            'updatedAt',
            'publishedAt'
          ])
          && request.resource.data.hubId == hubId
          && request.resource.data.status in ['draft', 'published'];
        allow update: if isSuperadmin()
          && request.resource.data.keys().hasOnly([
            'hubId',
            'slug',
            'title',
            'status',
            'draftComposition',
            'publishedComposition',
            'headerIdOverride',
            'footerIdOverride',
            'seo',
            'createdAt',
            'updatedAt',
            'publishedAt'
          ])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'slug',
            'title',
            'status',
            'draftComposition',
            'publishedComposition',
            'headerIdOverride',
            'footerIdOverride',
            'seo',
            'updatedAt',
            'publishedAt'
          ])
          && request.resource.data.hubId == resource.data.hubId
          && request.resource.data.status in ['draft', 'published'];
        allow delete: if false;
      }

      match /mediaFolders/{folderId} {
        allow read: if isHubAdmin(hubId) || isSuperadmin();
        allow create: if (isHubAdmin(hubId) || isSuperadmin())
          && request.resource.data.keys().hasOnly(['hubId', 'name', 'isSystem', 'createdAt', 'updatedAt'])
          && request.resource.data.hubId == hubId;
        allow update: if (isHubAdmin(hubId) || isSuperadmin())
          && request.resource.data.keys().hasOnly(['hubId', 'name', 'isSystem', 'createdAt', 'updatedAt'])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.hubId == resource.data.hubId
          && request.resource.data.isSystem == resource.data.isSystem
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isHubAdmin(hubId) || isSuperadmin();
      }

      match /media/{mediaId} {
        allow read: if isHubAdmin(hubId) || isSuperadmin();
        allow create: if (isHubAdmin(hubId) || isSuperadmin())
          && request.resource.data.keys().hasOnly([
            'hubId',
            'filename',
            'storagePath',
            'publicUrl',
            'type',
            'contentType',
            'sizeBytes',
            'folderId',
            'alt',
            'width',
            'height',
            'usageCount',
            'usageRefs',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.hubId == hubId;
        allow update: if (isHubAdmin(hubId) || isSuperadmin())
          && request.resource.data.keys().hasOnly([
            'hubId',
            'filename',
            'storagePath',
            'publicUrl',
            'type',
            'contentType',
            'sizeBytes',
            'folderId',
            'alt',
            'width',
            'height',
            'usageCount',
            'usageRefs',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'filename',
            'publicUrl',
            'contentType',
            'sizeBytes',
            'folderId',
            'alt',
            'width',
            'height',
            'usageCount',
            'usageRefs',
            'status',
            'updatedAt'
          ])
          && request.resource.data.hubId == resource.data.hubId
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if (isHubAdmin(hubId) || isSuperadmin()) && resource.data.usageCount == 0;
      }

      match /users/{uid}/avatarMedia/{mediaId} {
        allow read: if isSignedIn()
          && (
            (uid == request.auth.uid && userHubId() == hubId)
            || isHubAdmin(hubId)
            || isSuperadmin()
          );
        allow create: if isSignedIn() && uid == request.auth.uid && userHubId() == hubId
          && request.resource.data.keys().hasOnly([
            'filename',
            'storagePath',
            'publicUrl',
            'type',
            'contentType',
            'sizeBytes',
            'alt',
            'width',
            'height',
            'status',
            'createdAt',
            'updatedAt'
          ]);
        allow update: if isSignedIn() && uid == request.auth.uid && userHubId() == hubId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'alt',
            'status',
            'updatedAt',
            'filename',
            'contentType',
            'sizeBytes',
            'publicUrl',
            'storagePath'
          ]);
        allow delete: if isSignedIn() && uid == request.auth.uid && userHubId() == hubId;
      }
    }
  }
}
